# Copy this file to .env and fill in your own values.
# Never commit .env. Write values without quotes.

# --- Shared ---
# Snowflake account identifier, for example abc12345-xy67890
SNOWFLAKE_ACCOUNT=
SWEDAVIA_API_KEY=

# --- Streamlit (reads the marts) ---
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=SWEDAVIA_WH
SNOWFLAKE_DATABASE=FLIGHT_DB
SNOWFLAKE_SCHEMA=ANALYTICS_MARTS

# --- dbt (run by Dagster) ---
DBT_SNOWFLAKE_USER=
DBT_SNOWFLAKE_PASSWORD=

# --- dlt (run by Dagster) ---
DESTINATION__SNOWFLAKE__CREDENTIALS__DATABASE=FLIGHT_DB
DESTINATION__SNOWFLAKE__CREDENTIALS__USERNAME=SWEDAVIA_LOADER
DESTINATION__SNOWFLAKE__CREDENTIALS__PASSWORD=
DESTINATION__SNOWFLAKE__CREDENTIALS__HOST=
DESTINATION__SNOWFLAKE__CREDENTIALS__WAREHOUSE=SWEDAVIA_WH
DESTINATION__SNOWFLAKE__CREDENTIALS__ROLE=SWEDAVIA_DLT_ROLE
