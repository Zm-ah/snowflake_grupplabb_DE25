Table dim_airport {
  airport_key varchar [pk]
  icao varchar
  airport_name varchar
  city_served varchar
  usage varchar
  passengers_2023 int
}

Table dim_date {
  date_key date [pk]
  year int
  month int
  day int
  weekday_name varchar
  is_weekend boolean
}

Table dim_airline {
  airline_key varchar [pk]
  iata varchar
  icao varchar
  airline_name varchar
  country varchar
  call_sign varchar
}

Table fact_flights {
  flight_key varchar [pk]
  flight_id varchar
  airport_key varchar
  airline_key varchar
  date_key date
  direction varchar
  scheduled_utc timestamp
  actual_utc timestamp
  delay_minutes float
  is_delayed boolean
  is_cancelled boolean
  status_code varchar
}

Ref: fact_flights.airport_key > dim_airport.airport_key
Ref: fact_flights.airline_key > dim_airline.airline_key
Ref: fact_flights.date_key > dim_date.date_key
-- dim_date: one row per calendar date, generated by Snowflake (no source table needed).

with dates as (

    -- Generate 365 consecutive days starting on 2026-01-01
    select
        dateadd(day, seq4(), '2026-01-01'::date) as date_key
    from table(generator(rowcount => 365))

)

select
    date_key,
    year(date_key)                          as year,
    month(date_key)                         as month,
    day(date_key)                           as day,
    dayname(date_key)                       as weekday_name,   -- 'Mon', 'Tue', ...
    dayofweekiso(date_key) in (6, 7)        as is_weekend      -- 6 = Saturday, 7 = Sunday
from dates 