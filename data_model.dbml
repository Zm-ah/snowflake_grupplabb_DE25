
Table dim_airport {
  airport_key varchar [pk]
  iata_code varchar
  icao_code varchar
  airport_name varchar
  city varchar
  airport_usage varchar
  runways varchar
  passengers_2023 float
}

Table dim_date {
  date_key date [pk]
  year int
  month int
  day int
  weekday_name varchar
  is_weekend boolean
}

Table dim_airline {
  airline_key varchar [pk]
  airline_iata varchar
  airline_icao varchar
  airline_name varchar
  call_sign varchar
  country varchar
}

Table fct_flights {
  flight_key varchar [pk]
  flight_id varchar
  airport_key varchar
  airline_key varchar
  direction varchar
  flight_date date
  callsign varchar
  departure_airport varchar
  arrival_airport varchar
  flight_status varchar
  status_group varchar
  scheduled_utc timestamp
  estimated_utc timestamp
  actual_utc timestamp
  delay_minutes float
  is_cancelled boolean
  is_deleted boolean
  has_actual_time boolean
  is_delayed boolean
}

Ref: fct_flights.airport_key > dim_airport.airport_key
Ref: fct_flights.airline_key > dim_airline.airline_key
Ref: fct_flights.flight_date > dim_date.date_key