    UPPER(TRIM(AIRLINE_OPERATOR__IATA)) AS airline_iata,
    UPPER(TRIM(AIRLINE_OPERATOR__ICAO)) AS airline_icao,
    TRIM(AIRLINE_OPERATOR__NAME) AS airline_name,
    LOCATION_AND_STATUS__FLIGHT_LEG_STATUS_ENGLISH AS flight_status,

    COALESCE(
        ARRIVAL_TIMESCHEDULED_UTC,
        DEPARTURE_TIMESCHEDULED_UTC
    ) AS scheduled_utc,

    COALESCE(
        ARRIVAL_TIMEESTIMATED_UTC,
        DEPARTURE_TIMEESTIMATED_UTC
    ) AS estimated_utc,

    COALESCE(
        ARRIVAL_TIMEACTUAL_UTC,
        DEPARTURE_TIME__ACTUAL_UTC
    ) AS actual_utc

FROM FLIGHT_DB.STAGING.flights
  )
