SELECT DISTINCT
    FLIGHT_ID AS flight_id,
    AIRPORT AS airport,
    DIRECTION AS direction,
    FLIGHT_DATE AS flight_date,
    FLIGHT_LEG_IDENTIFIERCALLSIGN AS callsign,
