        ARRIVAL_TIMEESTIMATED_UTC,
        DEPARTURE_TIMEESTIMATED_UTC
    ) AS estimated_utc,

    COALESCE(
        ARRIVAL_TIMEACTUAL_UTC,
        DEPARTURE_TIME__ACTUAL_UTC
    ) AS actual_utc

FROM FLIGHT_DB.STAGING.flights
  )
